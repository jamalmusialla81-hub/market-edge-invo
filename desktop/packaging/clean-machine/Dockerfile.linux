# Clean Linux machine for the installed-app test: Ubuntu 22.04 with only the
# desktop runtime libraries the .deb declares (webkit/gtk), a virtual display
# and jq. No Python, no Node, no repository.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
COPY *.deb /tmp/
RUN apt-get update \
 && apt-get install -y --no-install-recommends /tmp/*.deb xvfb xauth jq procps imagemagick ca-certificates dbus-x11 \
 && rm -rf /var/lib/apt/lists/* /tmp/*.deb
RUN if command -v python3 || command -v python || command -v node || command -v npm; then echo "image is not clean"; exit 1; fi
WORKDIR /work
