{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-edge-ai",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "MARKET_EDGE_DB",
      "database_name": "market-edge-research",
      "database_id": "39a4082e-41a4-45e9-9b76-99cf10eaca01",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  "services": [{"binding":"MARKET_EVALUATOR","service":"market-edge-evaluator"}],
  "vars": {
    "ALLOWED_ORIGINS": "https://jamalmusialla81-hub.github.io,https://marketedge-app.base44.app,https://market-edge-customer-beta.pages.dev",
    "VISION_MODEL": "gpt-5.6-terra",
    "CHAT_MODEL": "gpt-5.6-luna",
    "RATE_LIMIT_PER_MINUTE": "12",
    "OPENAI_TIMEOUT_MS": "25000"
  }
}
